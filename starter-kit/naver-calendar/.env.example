# 보통은 캘린더_연결.bat 이 이 파일 대신 .env 를 만들어 줍니다. 직접 쓸 때만 복사해서 이름을 .env 로 바꾸세요.
#
# 🔒 .env 는 비밀번호와 같습니다. 남에게 주거나 인터넷에 올리지 마세요.

# 네이버 아이디 (hong 또는 hong@naver.com)
NAVER_CAL_USER=아이디

# 애플리케이션 비밀번호 — 평소 로그인 비밀번호가 아닙니다.
#   네이버 → 내정보 → 보안설정 → 2단계 인증 관리 → 애플리케이션 비밀번호 생성 (12자리, 대문자·숫자)
#   메일 연결에 쓴 네이버 앱 비밀번호를 같이 써도 됩니다.
NAVER_CAL_APP_PASSWORD=

# 서버 주소 — 비우면 https://caldav.calendar.naver.com
# NAVER_CAL_URL=
